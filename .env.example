NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Phase 2 (Admin Authentication): the ONLY email allowed to sign up as admin
# (D-01/D-02/D-03, PLAN.md). Comma-separated for forward compatibility, but
# exactly one address is the current design. Server-only — never prefix with
# NEXT_PUBLIC_.
ADMIN_ALLOWLIST_EMAIL=admin@asobarcelona.example

# Phase 3 (Houses & Resident Access): secret used to sign/verify the
# resident's app-level session cookie (jose, HS256) — Pattern A, no Supabase
# Auth session for residents. Generate with e.g. `openssl rand -base64 32`.
# Server-only — never prefix with NEXT_PUBLIC_.
RESIDENT_SESSION_SECRET=change-me-to-a-long-random-string

# USD/Bs exchange rate cron (vercel.json: daily at 23:00 VET). Verifies the
# scheduled request actually came from Vercel's cron system, not a public
# hit on the route. Generate with e.g. `openssl rand -base64 32`.
# Server-only — never prefix with NEXT_PUBLIC_.
CRON_SECRET=change-me-to-a-long-random-string

# API key for cotizave.com's exchange-rate aggregator (BCV + Binance P2P
# rates) — sign up at https://app.cotizave.com. Server-only — never prefix
# with NEXT_PUBLIC_.
COTIZAVE_API_KEY=ctz_live_xxxxx
